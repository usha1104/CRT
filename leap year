3. Check for leap year
#include<iostream>
using namespace std;
int main(){
    int year;
    cin>>year;
    if(year % 4 == 0){
        if(year % 100 == 0){
            if(year % 400 == 0){
                cout<<"Its is a leap year";
            }
            else{
                cout<<"Its is not a leap year";
            }
        }
        else{
            cout<<"It is a leap year";
        }
    }
    else{
        cout<<"It is not a leap year";
    }
 
  return 0;
}
  
